.brand img {
  width: 3.6rem;
  height: auto;
}
.brand-word {
  display: flex;
  flex-direction: column;
  line-height: 1.15;
}
.brand-word b {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 1.12rem;
  letter-spacing: 0.01em;
}
.brand-word small {
  font-family: var(--font-sans);
  font-size: 0.64rem;
  font-weight: 500;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--gold);
}