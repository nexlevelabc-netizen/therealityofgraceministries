# ── Database (required) ───────────────────────────────────────
# Postgres connection string, e.g. from Neon:
# postgres://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ── Giving (optional) ─────────────────────────────────────────
STRIPE_SECRET_KEY=        # Stripe secret key; without it giving falls back to bank transfer pledge
SITE_ORIGIN=              # Public origin, e.g. https://your-app.onrender.com (Stripe redirect URLs)

# ── Live streaming (optional) ─────────────────────────────────
STREAM_HLS_URL=           # .m3u8 playback URL from Mux / Cloudflare Stream / api.video
YOUTUBE_LIVE_VIDEO_ID=    # optional: pin the player to one YouTube broadcast (the id from its watch URL)

# ── Grace Companion chatbot (optional) ────────────────────────
# Any OpenAI-compatible chat endpoint, e.g. Moonshot:
#   CHAT_AI_BASE_URL=https://api.moonshot.ai/v1
#   CHAT_AI_MODEL=kimi-k2-0905-preview
CHAT_AI_BASE_URL=
CHAT_AI_API_KEY=
CHAT_AI_MODEL=

# ── Email notifications (optional) ────────────────────────────
# Every form is mirrored to info@therealityofgraceministries.com when set
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Member sign in (Kimi platform only) ───────────────────────
# These exist only when the site runs on Kimi. On any other host leave them
# empty: the sign in page then shows a graceful notice instead.
APP_ID=
APP_SECRET=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
OWNER_UNION_ID=
VITE_KIMI_AUTH_URL=
VITE_APP_ID=
